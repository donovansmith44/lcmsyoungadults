rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && ('email' in request.auth.token)
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // The currently-running session id (from the meta/activeSession pointer), or null
    // when none is running. Used to scope taker-name uniqueness to the active session.
    function activeSessionId() {
      return exists(/databases/$(database)/documents/meta/activeSession)
        ? get(/databases/$(database)/documents/meta/activeSession).data.get('sessionId', null)
        : null;
    }

    // Takers: doc id is the unique (normalized) username. Browser-owned via ownerUid.
    match /takers/{username} {
      allow read: if signedIn();
      // create only when absent (id uniqueness) and only claiming your own uid
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      // the owner may update/delete their own doc; admins may update (group override)
      // sharing is irreversible: once true it cannot be set back to false
      allow update: if signedIn() && (
        // (a) normal owner/admin update — the taker keeps its identity
        (
          (resource.data.ownerUid == request.auth.uid || isAdmin())
          && request.resource.data.ownerUid == resource.data.ownerUid
          && (resource.data.get('sharing', false) != true || request.resource.data.sharing == true)
          && (resource.data.get('sessionId', null) == null || request.resource.data.get('sessionId', null) == resource.data.get('sessionId', null))
        )
        // (b) reclaim a stale name — a DIFFERENT browser takes over a taker that is NOT
        // bound to the currently-running session (past-session or session-less name frees up).
        || (
          request.resource.data.ownerUid == request.auth.uid
          && resource.data.ownerUid != request.auth.uid
          && !(resource.data.get('sessionId', null) == activeSessionId() && activeSessionId() != null)
        )
      );
      allow delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Sessions: anyone signed-in may read (takers need timer/active state);
    // only allowlisted admins may write.
    match /sessions/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Admins allowlist: readable by signed-in (to self-check); writable by admins only.
    match /admins/{email} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // App singletons (e.g. the active-session pointer): readable by any signed-in
    // client; writable only by admins (mirrors sessions).
    match /meta/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
