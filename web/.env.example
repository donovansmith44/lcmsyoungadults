# Firebase web config. These are NOT secrets (security is enforced by Firestore
# rules + Auth), but the real values live in gitignored env files, not here.
#
# Local dev against the emulator → web/.env.development.local
#   VITE_USE_EMULATOR=1  + the demo-lya placeholder values below
# Production build (npm run build) → web/.env.production.local
#   VITE_USE_EMULATOR=0  + the real values from the Firebase console Web App config
#
# (.env.local is intentionally NOT used — it loads in every mode and would leak
#  emulator settings into the production bundle.)

VITE_USE_EMULATOR=
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
